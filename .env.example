# Postgres -------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hexachat
POSTGRES_PASSWORD=hexachat
POSTGRES_DB=hexachat

# Redis ----------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Kafka ----------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=hexachat

# JWT (shared between both services) -----------------------------------------
JWT_SECRET_KEY=please-change-me-to-32-bytes-of-randomness
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# chat-core ------------------------------------------------------------------
CORE_ENVIRONMENT=local
CORE_LOG_LEVEL=INFO
CORE_OUTBOX_BATCH_SIZE=100
CORE_OUTBOX_POLL_INTERVAL_MS=200

# presence-gateway -----------------------------------------------------------
GATEWAY_ENVIRONMENT=local
GATEWAY_LOG_LEVEL=INFO
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=20
GATEWAY_PRESENCE_TTL_SECONDS=60
